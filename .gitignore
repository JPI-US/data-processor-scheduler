# ---- Node / build ----
node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/
.nitro

# ---- Secrets (NEVER commit) ----
.env
.env.*
!.env.example
.dev.vars

# ---- Generated pipeline output ----
# Raw ESP32 capture logs and generated reports are runtime artifacts.
logs/
*.log
!*.log.example
public/reports/
data/

# Local-only working files: planning docs, codebase reviews, exports, and
# superseded/legacy scripts. Kept on disk under _local/ but never committed.
_local/
# Local backups of archived/retired reports (runtime artifacts, like reports/).
_archive/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Temp capture script written at runtime
axum_capture.ps1

# ---- Wrangler / Cloudflare ----
.wrangler/

# ---- Editor / OS ----
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# ---- Export artifacts ----
*.zip

# ---- Debug logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local
